{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuuki/grafana-llm-studio-app/schemas/dashboard-ir.schema.json",
  "title": "DashboardIR",
  "description": "Restricted intermediate representation (IR v1.1, backward-compatible with v1.0) for LLM-generated and safely imported Grafana dashboards.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "title",
    "timeRange",
    "panels"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0", "1.1"],
      "description": "IR schema version. New drafts use 1.1; 1.0 remains accepted for backward compatibility."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "description": "Monotonically increasing draft revision managed by the backend."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Dashboard title (plain text, no HTML/JS)."
    },
    "description": {
      "type": "string",
      "maxLength": 400,
      "description": "Optional short dashboard summary."
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string",
          "enum": ["now-5m", "now-15m", "now-30m", "now-1h", "now-3h", "now-6h"],
          "description": "Bounded relative start time. Initial preview defaults to now-15m."
        },
        "to": {
          "type": "string",
          "enum": ["now"],
          "description": "Relative end time fixed to now."
        }
      }
    },
    "variables": {
      "type": "array",
      "maxItems": 4,
      "description": "Optional scoped dashboard template variables (max 4). Referenced in PromQL label matchers as $name or ${name:regex}.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,31}$",
            "description": "Template variable identifier referenced via $name."
          },
          "label": {
            "type": "string",
            "maxLength": 64,
            "description": "Optional display label in the dashboard variable bar."
          },
          "type": {
            "type": "string",
            "enum": ["query", "custom"],
            "description": "Restricted variable kind: Prometheus label_values query or bounded custom option list."
          },
          "datasourceRef": {
            "type": "string",
            "enum": ["selected_prometheus"],
            "description": "Required for type=query variables; bound to the admin-allowlisted Prometheus datasource."
          },
          "labelName": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$",
            "description": "Prometheus label name queried by label_values(...) when type=query."
          },
          "metricName": {
            "type": "string",
            "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]{0,127}$",
            "description": "Optional catalog metric name scoping label_values(metricName, labelName) when type=query."
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "description": "Bounded static values when type=custom.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "defaultValue": {
            "type": "string",
            "maxLength": 128,
            "description": "Initial selected value used for preview and dry-run validation."
          },
          "multi": {
            "type": "boolean",
            "description": "Whether multiple values can be selected (requires =~ matcher in PromQL)."
          },
          "includeAll": {
            "type": "boolean",
            "description": "Whether an All option is offered (requires =~ matcher; disallowed on required scope filter variable)."
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "description": "Allows 1 to 6 panels.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "datasourceRef",
          "unit",
          "layout"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^panel-[a-z0-9][a-z0-9-]{0,31}$",
            "description": "Stable panel identifier used for partial edits and diffs."
          },
          "type": {
            "type": "string",
            "enum": [
              "timeseries",
              "stat",
              "table",
              "gauge",
              "bargauge",
              "piechart",
              "state-timeline"
            ],
            "description": "Allowlisted Grafana visualization panel type."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 240
          },
          "datasourceRef": {
            "type": "string",
            "enum": ["selected_prometheus"],
            "description": "Logical reference bound to the admin-allowlisted, user-selected Prometheus datasource. Arbitrary UIDs or URLs are forbidden."
          },
          "query": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expr"],
            "description": "Single query (v1.0 compatible). Mutually exclusive with queries.",
            "properties": {
              "refId": {
                "type": "string",
                "enum": ["A", "B", "C"],
                "description": "Optional deterministic query refId (defaults to A)."
              },
              "kind": {
                "type": "string",
                "enum": ["promql", "metricsql"],
                "description": "Optional query dialect (inherits job dialect when omitted; defaults to promql)."
              },
              "expr": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Query expression validated deterministically against syntax, policy, variables, and scoped catalog."
              },
              "legendFormat": {
                "type": "string",
                "maxLength": 80
              }
            }
          },
          "queries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "description": "Bounded multi-query list (1 to 3 queries per panel). Mutually exclusive with query.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["expr"],
              "properties": {
                "refId": {
                  "type": "string",
                  "enum": ["A", "B", "C"],
                  "description": "Optional unique query refId (defaults to A, B, C in order)."
                },
                "kind": {
                  "type": "string",
                  "enum": ["promql", "metricsql"],
                  "description": "Optional query dialect (inherits job dialect when omitted; defaults to promql)."
                },
                "expr": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "Query expression validated deterministically against syntax, policy, variables, and scoped catalog."
                },
                "legendFormat": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            }
          },
          "unit": {
            "type": "string",
            "enum": [
              "short",
              "none",
              "percent",
              "percentunit",
              "reqps",
              "ops",
              "s",
              "ms",
              "bytes",
              "decbytes",
              "Bps"
            ],
            "description": "Allowlisted Grafana standard unit identifier."
          },
          "thresholds": {
            "type": "array",
            "maxItems": 4,
            "description": "Optional ascending absolute threshold steps.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "color"],
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": -1000000000,
                  "maximum": 1000000000
                },
                "color": {
                  "type": "string",
                  "enum": ["green", "yellow", "orange", "red", "blue"]
                }
              }
            }
          },
          "layout": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "col", "width"],
            "properties": {
              "row": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "col": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1,
                "description": "Two-column grid hint (0 = left, 1 = right)."
              },
              "width": {
                "type": "string",
                "enum": ["half", "full"],
                "description": "Grid width hint normalized to 12 (half) or 24 (full) columns."
              }
            }
          }
        }
      }
    }
  }
}
