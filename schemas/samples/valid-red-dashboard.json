{
  "schemaVersion": "1.0",
  "revision": 1,
  "title": "checkout-api RED Overview",
  "description": "Request rate, error ratio, and p95 latency for checkout-api.",
  "timeRange": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": "panel-request-rate",
      "type": "timeseries",
      "title": "Request Rate",
      "description": "HTTP requests per second grouped by status class.",
      "datasourceRef": "selected_prometheus",
      "query": {
        "expr": "sum by (status) (rate(http_requests_total{service=\"checkout-api\"}[5m]))",
        "legendFormat": "{{status}}"
      },
      "unit": "reqps",
      "layout": {
        "row": 0,
        "col": 0,
        "width": "half"
      }
    },
    {
      "id": "panel-error-rate",
      "type": "stat",
      "title": "5xx Error Ratio",
      "description": "Percentage of HTTP 5xx responses over total requests.",
      "datasourceRef": "selected_prometheus",
      "query": {
        "expr": "sum(rate(http_requests_total{service=\"checkout-api\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{service=\"checkout-api\"}[5m])), 1e-9)",
        "legendFormat": "5xx ratio"
      },
      "unit": "percentunit",
      "thresholds": [
        { "value": 0, "color": "green" },
        { "value": 0.01, "color": "yellow" },
        { "value": 0.05, "color": "red" }
      ],
      "layout": {
        "row": 0,
        "col": 1,
        "width": "half"
      }
    },
    {
      "id": "panel-latency-p95",
      "type": "timeseries",
      "title": "p95 Request Latency",
      "description": "95th percentile HTTP request duration.",
      "datasourceRef": "selected_prometheus",
      "query": {
        "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"checkout-api\"}[5m])))",
        "legendFormat": "p95"
      },
      "unit": "s",
      "thresholds": [
        { "value": 0, "color": "green" },
        { "value": 0.5, "color": "yellow" },
        { "value": 1.0, "color": "red" }
      ],
      "layout": {
        "row": 1,
        "col": 0,
        "width": "full"
      }
    }
  ]
}
