{
  "name": "yuuki-llmstudio-app",
  "version": "0.1.0",
  "description": "OSS LLM Dashboard Studio App Plugin for Grafana OSS 12.4.15 and 13.3.1",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand",
    "test:e2e": "playwright test",
    "verify:schemas": "node scripts/verify-schema-sync.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "12.4.15",
    "@grafana/grafana-foundation-sdk": "0.0.22",
    "@grafana/i18n": "12.4.15",
    "@grafana/runtime": "12.4.15",
    "@grafana/scenes": "9.3.0",
    "@grafana/schema": "12.4.15",
    "@grafana/ui": "12.4.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@grafana/e2e-selectors": "12.4.15",
    "@grafana/plugin-e2e": "4.1.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "copy-webpack-plugin": "12.0.2",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.2",
    "typescript": "5.7.3",
    "webpack": "5.97.1",
    "webpack-cli": "5.1.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
