{
  "name": "yuuki-llmstudio-app",
  "version": "0.1.0",
  "description": "OSS LLM Dashboard Studio App Plugin for Grafana OSS 12.4.15 and 13.3.1",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "build:backend": "node scripts/build-backend.mjs",
    "build:backend:all": "node scripts/build-backend.mjs --all",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand",
    "test:e2e": "playwright test",
    "test:release": "node --test scripts/release-lib.test.mjs",
    "sign": "sign-plugin",
    "package": "node scripts/package-release.mjs",
    "package:airgap": "node scripts/package-release.mjs --airgap",
    "verify:schemas": "node scripts/verify-schema-sync.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "12.4.15",
    "@grafana/grafana-foundation-sdk": "0.0.22",
    "@grafana/i18n": "12.4.15",
    "@grafana/runtime": "12.4.15",
    "@grafana/scenes": "9.3.0",
    "@grafana/schema": "12.4.15",
    "@grafana/ui": "12.4.15",
    "i18next": "25.10.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@grafana/e2e-selectors": "12.4.15",
    "@grafana/eslint-config": "10.0.0",
    "@grafana/plugin-e2e": "4.1.1",
    "@grafana/sign-plugin": "3.3.3",
    "@playwright/test": "1.65.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "copy-webpack-plugin": "12.0.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.2",
    "typescript": "5.7.3",
    "webpack": "5.97.1",
    "webpack-cli": "7.3.1"
  },
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26 <27"
  }
}
